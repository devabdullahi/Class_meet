# ---------------------------------------------------------------------------
# Class Meet — client environment
# Copy this file to `client/.env` and fill in the value.
# `client/.env` is git-ignored.
#
# Only VITE_-prefixed variables reach the browser, and everything here IS
# public: it is compiled into the JavaScript bundle. Never put a secret in
# this file. A client ID and a tenant ID are designed to be public; the server
# is what decides whether a token is acceptable.
# ---------------------------------------------------------------------------

# The same Application (client) ID as ENTRA_CLIENT_ID in server/.env.
# Azure portal -> Microsoft Entra ID -> App registrations -> your app ->
# Overview -> Application (client) ID. A GUID.
#
# If this and the server's copy disagree, the login page says so instead of
# letting the sign-in fail with an opaque 401.
VITE_ENTRA_CLIENT_ID=

# Optional. The tenant whose sign-in page the app sends students to, which
# defaults to UT Arlington's. Overriding it only changes which login page
# appears — who is actually allowed in is decided by UTA_TENANT_ID on the
# server, against a claim Microsoft signed.
VITE_ENTRA_TENANT_ID=5cdc5b43-d7be-4caa-8173-729e3b0a62d9
