{
  "name": "class-meet",
  "private": true,
  "version": "0.2.0",
  "description": "Class Meet \u2014 a course-scoped study group finder (CSE 3311, UT Arlington)",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "up": "node scripts/dev.mjs",
    "dev": "concurrently --names \"server,client\" --prefix-colors \"blue,magenta\" --kill-others-on-fail \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace server && npm run build --workspace client",
    "typecheck": "npm run typecheck --workspace server && npm run typecheck --workspace client",
    "migrate": "npm run migrate --workspace server",
    "migrate:status": "npm run migrate:status --workspace server",
    "start": "npm run start --workspace server"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
