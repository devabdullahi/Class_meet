# ---------------------------------------------------------------------------
# Class Meet — server environment
# Copy this file to `server/.env` and fill in the real values.
# `server/.env` is git-ignored. Never commit real secrets.
# ---------------------------------------------------------------------------

# Port the API listens on. The Vite dev server proxies /api here.
PORT=4000

# "development" or "production". In production the session cookie is
# marked Secure, so the app must be served over HTTPS.
NODE_ENV=development

# ---------------------------------------------------------------------------
# Microsoft Entra ID sign-in
# ---------------------------------------------------------------------------
# The **Application (client) ID** of the app registration, from the Azure
# portal: Microsoft Entra ID -> App registrations -> your app -> Overview.
# A GUID, e.g. 11111111-2222-3333-4444-555555555555
#
# Must be the SAME value as VITE_ENTRA_CLIENT_ID in client/.env: the server
# checks the access token's `aud` claim against it. There is no client
# *secret* — a single-page app is a public client and cannot keep one.
#
# Left blank, the server still boots and sign-in returns a clear 503.
ENTRA_CLIENT_ID=

# UT Arlington's Entra tenant. This is the ACCESS POLICY: the server admits a
# sign-in only if the `tid` claim on the Microsoft-signed token equals this.
# Already filled in — confirmed against
#   https://login.microsoftonline.com/uta.edu/v2.0/.well-known/openid-configuration
# and the same document for mavs.uta.edu, which both resolve to this tenant.
# Change it only to point the app at a different organisation.
UTA_TENANT_ID=5cdc5b43-d7be-4caa-8173-729e3b0a62d9

# Name of the delegated scope published on the app registration under
# "Expose an API". The SPA asks for `api://<ENTRA_CLIENT_ID>/<this>`, and the
# server requires it in the token's `scp` claim. The default matches the name
# used in the README walkthrough; change both or neither.
ENTRA_API_SCOPE=access_as_user

# ---------------------------------------------------------------------------
# Session
# ---------------------------------------------------------------------------
# Secret used to sign the session JWT stored in the httpOnly cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Must be at least 32 characters. Changing it logs everyone out.
SESSION_SECRET=

# How long a session lasts before the user must sign in again.
SESSION_TTL_DAYS=7

# ---------------------------------------------------------------------------
# Access control
# ---------------------------------------------------------------------------
# Origin(s) of the front end, comma-separated. Used for the Origin check on
# state-changing requests.
CLIENT_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Database (Neon serverless Postgres)
# ---------------------------------------------------------------------------
# POOLED connection string from the Neon console (hostname contains "-pooler").
# Used by the running API server.
#   postgresql://USER:PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Optional: DIRECT / unpooled connection string (hostname WITHOUT "-pooler").
# Used by `npm run migrate`, because migration tools and DDL do not play well
# with transaction pooling. If left blank, migrations fall back to DATABASE_URL.
DIRECT_DATABASE_URL=

# ---------------------------------------------------------------------------
# DEVELOPMENT SIGN-IN BYPASS — REMOVE BEFORE THE PILOT
# ---------------------------------------------------------------------------
# Iteration-1 scaffolding, off by default. Uncomment to add a
# "Skip sign-in (development only)" button that signs you in as a hard-coded
# fake student with no Microsoft account and no database, so the screens after
# sign-in can be worked on before ENTRA_CLIENT_ID and DATABASE_URL exist.
#
# Two gates: the value must be exactly "true", AND NODE_ENV must not be
# "production". Setting it together with NODE_ENV=production makes the server
# refuse to boot, rather than silently accept unauthenticated sign-ins.
#
# See server/src/dev-login.ts for what to delete when this goes.
# ALLOW_DEV_LOGIN=true
