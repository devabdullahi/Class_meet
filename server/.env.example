# ---------------------------------------------------------------------------
# Class Meet — server environment
# Copy this file to `server/.env` and fill in the real values.
# `server/.env` is git-ignored. Never commit real secrets.
# ---------------------------------------------------------------------------

# Port the API listens on. The Vite dev server proxies /api here.
PORT=4000

# "development" or "production". In production the session cookie is
# marked Secure, so the app must be served over HTTPS.
NODE_ENV=development

# ---------------------------------------------------------------------------
# Sign-in: a code emailed to a UTA address
# ---------------------------------------------------------------------------
# Students sign in with a 6-digit code sent to their UTA email. These are the
# outgoing-mail (SMTP) settings for sending it. Any SMTP service works.
#
# Left blank in development, the server prints each code to its own console
# as a "[dev email]" line instead, so you can sign in without sending mail.
# In production (NODE_ENV=production) the server REFUSES TO START without
# SMTP_HOST, so codes can never end up in a log.
#
# Zero-cost option: a Gmail account with 2-Step Verification on and an App
# Password (Google Account -> Security -> App passwords). Then:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=the Gmail address
#   SMTP_PASS=the 16-character app password (NOT the account password)
#   EMAIL_FROM=Class Meet <the same Gmail address>
# Brevo, Mailgun, SendGrid or a university relay work the same way with their
# own host, port and credentials.
SMTP_HOST=
# 465 with SMTP_SECURE=true (TLS from the start), or 587 with
# SMTP_SECURE=false (STARTTLS, which the server then insists on). Either may
# be left blank: each defaults from the other, and both blank means 465/TLS.
SMTP_PORT=
SMTP_SECURE=
# Both or neither (neither only for a relay that needs no sign-in).
SMTP_USER=
SMTP_PASS=
# The From line students see. Gmail requires it to be the account itself.
EMAIL_FROM=

# Which addresses may ask for a code, comma-separated. Matched exactly after
# the "@", so mavs.uta.edu does not admit x@mavs.uta.edu.evil.com.
# EMAIL_LOGIN_DOMAINS=mavs.uta.edu,uta.edu

# ---------------------------------------------------------------------------
# Microsoft Entra ID sign-in — OFF unless ENABLE_MICROSOFT_LOGIN=true
# ---------------------------------------------------------------------------
# UTA's Microsoft tenant requires an administrator to approve third-party
# apps, so students cannot consent to Class Meet and this sign-in is switched
# off. The code stays: if UTA grants admin consent, set
# ENABLE_MICROSOFT_LOGIN=true (and ENTRA_CLIENT_ID) and the login page offers
# "Sign in with Microsoft" next to the emailed code.
# ENABLE_MICROSOFT_LOGIN=true
#
# The **Application (client) ID** of the app registration, from the Azure
# portal: Microsoft Entra ID -> App registrations -> your app -> Overview.
# A GUID, e.g. 11111111-2222-3333-4444-555555555555
#
# Must be the SAME value as VITE_ENTRA_CLIENT_ID in client/.env: the server
# checks the access token's `aud` claim against it. There is no client
# *secret* — a single-page app is a public client and cannot keep one.
#
# Left blank, Microsoft sign-in stays off whatever ENABLE_MICROSOFT_LOGIN says.
ENTRA_CLIENT_ID=

# UT Arlington's Entra tenant. This is the ACCESS POLICY: the server admits a
# sign-in only if the `tid` claim on the Microsoft-signed token equals this.
# Already filled in — confirmed against
#   https://login.microsoftonline.com/uta.edu/v2.0/.well-known/openid-configuration
# and the same document for mavs.uta.edu, which both resolve to this tenant.
# Change it only to point the app at a different organisation.
UTA_TENANT_ID=5cdc5b43-d7be-4caa-8173-729e3b0a62d9

# Name of the delegated scope published on the app registration under
# "Expose an API". The SPA asks for `api://<ENTRA_CLIENT_ID>/<this>`, and the
# server requires it in the token's `scp` claim. The default matches the name
# used in the README walkthrough; change both or neither.
ENTRA_API_SCOPE=access_as_user

# ---------------------------------------------------------------------------
# Session
# ---------------------------------------------------------------------------
# Secret used to sign the session JWT stored in the httpOnly cookie, and the
# key (via HMAC) for the sign-in codes stored in the database.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Must be at least 32 characters. Changing it logs everyone out and
# invalidates any code already emailed.
SESSION_SECRET=

# How long a session lasts before the user must sign in again.
SESSION_TTL_DAYS=7

# ---------------------------------------------------------------------------
# Access control
# ---------------------------------------------------------------------------
# Origin(s) of the front end, comma-separated. Used for the Origin check on
# state-changing requests.
CLIENT_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Database (Neon serverless Postgres)
# ---------------------------------------------------------------------------
# POOLED connection string from the Neon console (hostname contains "-pooler").
# Used by the running API server.
#   postgresql://USER:PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Optional: DIRECT / unpooled connection string (hostname WITHOUT "-pooler").
# Used by `npm run migrate`, because migration tools and DDL do not play well
# with transaction pooling. If left blank, migrations fall back to DATABASE_URL.
DIRECT_DATABASE_URL=

# ---------------------------------------------------------------------------
# DEVELOPMENT SIGN-IN BYPASS — REMOVE BEFORE THE PILOT
# ---------------------------------------------------------------------------
# Iteration-1 scaffolding, off by default. Uncomment to add a
# "Skip sign-in (development only)" button that signs you in as a hard-coded
# fake student with no email and no database, so the screens after sign-in
# can be worked on before DATABASE_URL exists.
#
# Two gates: the value must be exactly "true", AND NODE_ENV must not be
# "production". Setting it together with NODE_ENV=production makes the server
# refuse to boot, rather than silently accept unauthenticated sign-ins.
#
# See server/src/dev-login.ts for what to delete when this goes.
# ALLOW_DEV_LOGIN=true
